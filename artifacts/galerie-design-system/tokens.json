{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Galerie mobile-first design tokens extracted from the supplied Android photo-management reference. Dark mode is source-matched; light mode is a deliberate accessible counterpart.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#F6F8FB" },
      "foreground": { "$value": "#18202A" },
      "border": { "$value": "#DCE3EC" },
      "card": { "$value": "#FFFFFF" },
      "cardForeground": { "$value": "#18202A" },
      "popover": { "$value": "#FFFFFF" },
      "popoverForeground": { "$value": "#18202A" },
      "primary": {
        "$value": "#2979D8",
        "$description": "Gallery blue for active navigation, switches, primary actions, and selection."
      },
      "primaryForeground": { "$value": "#FFFFFF" },
      "secondary": { "$value": "#E9EEF5" },
      "secondaryForeground": { "$value": "#1D2A38" },
      "muted": { "$value": "#EEF2F7" },
      "mutedForeground": { "$value": "#647286" },
      "accent": { "$value": "#D8E9FF" },
      "accentForeground": { "$value": "#164B82" },
      "destructive": { "$value": "#C94148" },
      "destructiveForeground": { "$value": "#FFFFFF" },
      "input": { "$value": "#D5DDE7" },
      "ring": { "$value": "#2979D8" },
      "mediaBackground": { "$value": "#000000" },
      "onMedia": { "$value": "#FFFFFF" },
      "chart1": { "$value": "#2979D8" },
      "chart2": { "$value": "#43A28F" },
      "chart3": { "$value": "#E49A3F" },
      "chart4": { "$value": "#7B6FD0" },
      "chart5": { "$value": "#D66083" },
      "sidebar": { "$value": "#FFFFFF" },
      "sidebarForeground": { "$value": "#263342" },
      "sidebarBorder": { "$value": "#DCE3EC" },
      "sidebarPrimary": { "$value": "#2979D8" },
      "sidebarPrimaryForeground": { "$value": "#FFFFFF" },
      "sidebarAccent": { "$value": "#E5F0FF" },
      "sidebarAccentForeground": { "$value": "#18548F" },
      "sidebarRing": { "$value": "#2979D8" }
    },
    "dark": {
      "background": { "$value": "#0B0F14" },
      "foreground": { "$value": "#F3F6FA" },
      "border": { "$value": "#27303A" },
      "card": { "$value": "#11171E" },
      "cardForeground": { "$value": "#F3F6FA" },
      "popover": { "$value": "#1A212A" },
      "popoverForeground": { "$value": "#F3F6FA" },
      "primary": { "$value": "#66A9F4" },
      "primaryForeground": { "$value": "#071525" },
      "secondary": { "$value": "#1B232C" },
      "secondaryForeground": { "$value": "#E8EDF4" },
      "muted": { "$value": "#171E26" },
      "mutedForeground": { "$value": "#98A5B5" },
      "accent": { "$value": "#213D5B" },
      "accentForeground": { "$value": "#DDEEFF" },
      "destructive": { "$value": "#FF727B" },
      "destructiveForeground": { "$value": "#2C0508" },
      "input": { "$value": "#2B3540" },
      "ring": { "$value": "#66A9F4" },
      "mediaBackground": { "$value": "#000000" },
      "onMedia": { "$value": "#FFFFFF" },
      "chart1": { "$value": "#66A9F4" },
      "chart2": { "$value": "#54C5AE" },
      "chart3": { "$value": "#F2B35B" },
      "chart4": { "$value": "#A59AF2" },
      "chart5": { "$value": "#F083A4" },
      "sidebar": { "$value": "#0E1319" },
      "sidebarForeground": { "$value": "#E8EDF4" },
      "sidebarBorder": { "$value": "#27303A" },
      "sidebarPrimary": { "$value": "#66A9F4" },
      "sidebarPrimaryForeground": { "$value": "#071525" },
      "sidebarAccent": { "$value": "#1C2B3A" },
      "sidebarAccentForeground": { "$value": "#DDEEFF" },
      "sidebarRing": { "$value": "#66A9F4" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Roboto", "sans-serif"],
        "$description": "Compact Android-inspired UI and body typeface."
      },
      "serif": { "$value": ["Roboto Slab", "serif"] },
      "mono": { "$value": ["Roboto Mono", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.75rem",
      "$description": "Rounded Material You geometry for cards, controls, and bottom navigation."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step components multiply."
    }
  }
}
