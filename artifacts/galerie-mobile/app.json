{
  "expo": {
    "name": "Galerie",
    "slug": "galerie",
    "owner": "shiny94s-team",
    "version": "1.1.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "galerie-mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Galerie potřebuje přístup k vaší knihovně fotek pro zobrazení snímků."
      }
    },
    "android": {
      "package": "app.galerie.mobile",
      "versionCode": 2,
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-media-library",
        {
          "photosPermission": "Galerie potřebuje přístup k vaší knihovně fotek pro zobrazení snímků.",
          "savePhotosPermission": "Galerie potřebuje přístup pro uložení snímků.",
          "isAccessMediaLocationEnabled": true,
          "granularPermissions": ["photo", "video"]
        }
      ],
      "expo-video",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B0F14"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "cb3fbb53-ac69-4bcb-a44d-3eedbb08a975"
      }
    }
  }
}
